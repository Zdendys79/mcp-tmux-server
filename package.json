{
  "name": "tmux-mcp-server",
  "version": "facemizoxuva",
  "description": "MCP server for real-time tmux terminal interaction",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prebuild": "node tools/version-generator.js > /tmp/mcp-version.txt && node -e \"const fs=require('fs');const pkg=JSON.parse(fs.readFileSync('./package.json'));pkg.version=fs.readFileSync('/tmp/mcp-version.txt','utf8').trim();fs.writeFileSync('./package.json',JSON.stringify(pkg,null,2)+'\\n')\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "tmux",
    "terminal",
    "monitoring"
  ],
  "author": "Zdendys & Nyara",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
